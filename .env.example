# ─────────────────────────────────────────────────────────────────
# ResolveAI-RAG — configuration
#
# Copy to `.env` and edit. EVERY value here has a working default in
# backend/app/config.py, so the project runs with no .env at all.
#
# Never commit the real .env — it is git-ignored for a reason.
# ─────────────────────────────────────────────────────────────────

# ── database ─────────────────────────────────────────────────────
# Relative paths resolve against backend/, so the app behaves the same
# whatever directory you launch it from.
DATABASE_PATH=./resolveai.db

# ── model provider (the LLM) ─────────────────────────────────────
# "mock"      deterministic rule engine — no API key, no network, free.
#             This is the default and what the whole test suite uses.
# "anthropic" the real API. Needs ANTHROPIC_API_KEY.
MODEL_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── agent bounds (the safety limits) ─────────────────────────────
AGENT_MAX_STEPS=6          # the loop cannot run forever
AGENT_TIMEOUT_S=30         # per model call
AGENT_MAX_RETRIES=2        # TRANSIENT provider errors only

# ── retrieval: master switches ───────────────────────────────────
RAG_ENABLED=true
RAG_MODE=hybrid            # hybrid | lexical | semantic

# ── retrieval: chunking ──────────────────────────────────────────
CHUNK_SIZE_WORDS=110       # target words per chunk
CHUNK_OVERLAP_WORDS=25     # words shared with the previous chunk

# ── retrieval: embeddings ────────────────────────────────────────
# "sentence-transformers" downloads ~90 MB once, then runs offline on CPU.
# "hashing" is a dependency-free deterministic stand-in for tests/CI. It
# measures VOCABULARY OVERLAP, not meaning — never use it for real quality.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
HASHING_EMBEDDING_DIM=512

# ── retrieval: vector index ──────────────────────────────────────
VECTOR_BACKEND=faiss       # faiss | numpy (identical results; faiss is faster)
VECTOR_INDEX_PATH=./data/index

# ── retrieval: candidates and fusion ─────────────────────────────
TOP_K_LEXICAL=10           # candidates BM25 feeds into fusion
TOP_K_SEMANTIC=10          # candidates vector search feeds into fusion
TOP_K_FINAL=4              # evidence chunks the LLM actually sees
RRF_K=60                   # RRF smoothing constant (the TREC default)

# Per-arm RRF vote weights. 1.0/1.0 is textbook RRF. The 0.8 default was
# chosen from the retrieval evaluation, not by feel: it raised recall@1 from
# 0.875 to 0.938 while keeping exact-identifier recall@1 at 1.00.
RRF_WEIGHT_LEXICAL=0.8
RRF_WEIGHT_SEMANTIC=1.0

# ── retrieval: reranking ─────────────────────────────────────────
# OFF by default, and that is a measured decision: the heuristic reranker
# LOWERED recall@1 on this corpus. See docs/hybrid_rag.md.
RERANKER=none              # none | heuristic | cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12

# ── grounding ────────────────────────────────────────────────────
MIN_SEMANTIC_SCORE=0.15    # cosine floor for a semantic candidate
REQUIRE_CITATIONS=true     # escalate an uncited factual answer

# ── observability ────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
